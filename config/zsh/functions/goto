# Presents a list of commonly visited locations in fzf,
# then navigates to the selected location

# Automatically includes any git repos, and can include
# custom locations defined by the user.

# the format of the shortcut and repo cache files is:
# <nickname> <path>
# With one entry per line. The nickname is what will be shown in fzf, 
# and the path is where goto will navigate to when that nickname is selected.

zmodload zsh/stat

# Ensure needed XDG Setup is complete
for var in XDG_CONFIG_HOME XDG_STATE_HOME; do
    if [[ -z ${(P)var} ]]; then
        print -u2 "goto: $var is not set."
        return 1
    fi
done

# $XDG_STATE_HOME is written to (repo cache), so it has to exist as a directory
if [[ ! -d $XDG_STATE_HOME ]]; then
    if ! mkdir -p $XDG_STATE_HOME; then
        print -u2 "goto: could not create XDG_STATE_HOME ($XDG_STATE_HOME)."
        return 1
    fi
fi


# REPO_SEARCH_DIRS is an array that should include all the places to
# recursively search for git repos. Feel free to overwrite the default.
if ! [[ -n $REPO_SEARCH_DIRS ]]; then
    REPO_SEARCH_DIRS=( $HOME/code )
fi
# SHORTCUTS is an user-defined shortcuts file
if ! [[ -n $SHORTCUTS ]]; then
    SHORTCUTS=$XDG_CONFIG_HOME/goto_shortcuts
    # seed the default shortcuts file if it isn't there yet. it's gitignored,
    # so a fresh checkout won't have one.
    if ! [[ -f $SHORTCUTS ]]; then
        echo "home $HOME" > $SHORTCUTS
    fi
fi
REPO_CACHE=$XDG_STATE_HOME/goto_cache
# the cache is built by cache_repos at the end of goto, so on the very first
# run it doesn't exist yet
if ! [[ -f $REPO_CACHE ]]; then
    touch $REPO_CACHE
fi


cache_repos() {
    # clear the existing cache
    if [[ -f $REPO_CACHE ]]; then
        rm $REPO_CACHE
   fi
    touch $REPO_CACHE
    # search for git repos recursively in the specified directories
    for search_dir in "$REPO_SEARCH_DIRS[@]"
    do 
        fd_result=( $(fd -H -g '.git' $search_dir) )
        for result in "${fd_result[@]}" 
        do
            repo_path=${result%/.git*}
            repo_name=${repo_path##*/}
            echo "$repo_name $repo_path" >> $REPO_CACHE
        done
    done 
}


goto() {
    all_search_files=( $SHORTCUTS $REPO_CACHE )

    # create an associative array of all paths and their nicknames
    declare -A paths_by_name
    for file in "$all_search_files[@]"
    do
        # don't let a missing or unreadable file abort the redirect below.
        # $SHORTCUTS may be user-supplied and point anywhere.
        if [[ ! -r $file ]]; then
            continue
        fi
        while read -r line
        do
            split=(${(@s[ ])line})
            location_name=$split[1]; location_path=$split[2]
            paths_by_name[$location_name]=$location_path
        done < $file 
    done

    # present the nicknames to the user for selection
    selected_name=$(echo ${(k)paths_by_name} | sed 's/ /\n/g' | fzf --height 40% --border)
    selected_path=$paths_by_name[$selected_name]
    selected_path="${selected_path/#\~/$HOME}" # expand any ~ in the path
    
    # navigate to the path, if one was selected
    if ! [ -z $selected_path ] 
    then
        cd $selected_path
    fi
    # run this in the background after goto finishes to avoid overwriting the cache while it's in use 
    cache_repos $REPO_CACHE $REPO_SEARCH_DIRS &!
}

goto

